# 28 and Three — environment variables
# Copy to .env.local for local development. Never commit .env.local.
# Credentials live in Dashlane collection "28-and-three".

# --- Database (three Neon roles — see docs/runbook.md#db-roles) ---
# app_read role, pooled. Used by Next.js server components.
DATABASE_URL=postgres://app_read:***@ep-XXXX-pooler.us-east-1.aws.neon.tech/twentyeightandthree?sslmode=require

# migrator role, unpooled. Used by drizzle-kit migrate in CI only.
MIGRATOR_DATABASE_URL=postgres://migrator:***@ep-XXXX.us-east-1.aws.neon.tech/twentyeightandthree?sslmode=require

# --- Sentry (web) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=28-and-three
SENTRY_PROJECT=28-and-three-web
# CI only — for source map upload.
SENTRY_AUTH_TOKEN=

# --- Debug trigger (local / preview only; must be empty in prod) ---
# When 'true' AND NODE_ENV !== 'production', /status?debug=boom throws a synthetic
# error (useful for validating Sentry wiring). See sentry.client.config.ts.
ALLOW_DEBUG_TRIGGER=false

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://28andthree.com

# --- ETL (Python) ---
# etl_writer role, unpooled. Used by etl/main.py via psycopg.
ETL_DATABASE_URL=postgres://etl_writer:***@ep-XXXX.us-east-1.aws.neon.tech/twentyeightandthree?sslmode=require
SENTRY_DSN_ETL=
SENTRY_MONITOR_SLUG=etl-weekly
