# 28 and Three — environment variables
# Copy to .env.local for local development. Never commit .env.local.
# Credentials live in Dashlane collection "28-and-three".

# --- Database (two created roles + neondb_owner as migrator; see docs/runbook.md#db-roles) ---
# app_read role. Used by Next.js server components.
DATABASE_URL=postgres://app_read:***@ep-XXXX-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# neondb_owner (plays the migrator role). Used by drizzle-kit migrate in CI only.
MIGRATOR_DATABASE_URL=postgres://neondb_owner:***@ep-XXXX-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Sentry (web) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=28-and-three
SENTRY_PROJECT=28-and-three-web
# CI only — for source map upload.
SENTRY_AUTH_TOKEN=

# --- Debug trigger (local / preview only; must be empty in prod) ---
# When 'true' AND NODE_ENV !== 'production', /status?debug=boom throws a synthetic
# error (useful for validating Sentry wiring). See sentry.client.config.ts.
ALLOW_DEBUG_TRIGGER=false

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://28andthree.com

# --- /status/data (admin JSON endpoint, plan §3.9) ---
# 32-byte hex token; rotation script in docs/runbook.md#status-data-auth.
# Endpoint returns 503 when unset (fail-closed).
STATUS_ADMIN_TOKEN=

# --- ISR revalidation webhook (/api/revalidate, E3-10) ---
# Shared secret between the ETL workflow and the Next route. Must be set in
# TWO places and match exactly:
#   1. Vercel production env  (vercel env add REVALIDATE_TOKEN production)
#   2. GitHub Actions secret  (gh secret set REVALIDATE_TOKEN)
# Min 16 chars. Unset in prod = the endpoint returns 503 and the ETL's flush
# step silently skips — pages then only self-heal on their ISR TTL.
# See docs/runbook.md#isr-revalidation.
REVALIDATE_TOKEN=

# --- Upstash Redis (durable rate limiter for /status/data) ---
# When either is missing, the limiter runs in permit-all mode (local dev only);
# prod should always have both provisioned.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- ETL (Python) ---
# etl_writer role. Used by etl/main.py via psycopg.
ETL_DATABASE_URL=postgres://etl_writer:***@ep-XXXX-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
SENTRY_DSN_ETL=
SENTRY_MONITOR_SLUG=etl-weekly
